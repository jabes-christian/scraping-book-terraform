#!/bin/bash
# Book price monitor - VM startup script (rendered by Terraform templatefile).
# Runs as root on every boot and must be idempotent. No secrets are rendered here.
# Note: in this template a literal dollar-brace must be written with two dollars;
# plain $VAR and $(command) are safe and are used on purpose.
set -euo pipefail

LOG_FILE=/var/log/book-monitor-startup.log
exec >>"$LOG_FILE" 2>&1
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] startup: begin"

export DEBIAN_FRONTEND=noninteractive

# --- 1. Swap (before any package install or build) ---------------------------
SWAP_FILE=/swapfile
if ! swapon --show=NAME --noheadings | grep -qx "$SWAP_FILE"; then
  if [ ! -f "$SWAP_FILE" ]; then
    fallocate -l ${swap_size_mb}M "$SWAP_FILE"
    chmod 600 "$SWAP_FILE"
    mkswap "$SWAP_FILE"
  fi
  swapon "$SWAP_FILE"
fi
if ! grep -q '^/swapfile ' /etc/fstab; then
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
echo 'vm.swappiness=60' > /etc/sysctl.d/99-book-monitor.conf
sysctl -p /etc/sysctl.d/99-book-monitor.conf

# --- 2. Base packages (only the missing ones) ---------------------------------
missing=""
for pkg in git cron logrotate curl ca-certificates; do
  if ! dpkg -s "$pkg" >/dev/null 2>&1; then
    missing="$missing $pkg"
  fi
done
if [ -n "$missing" ]; then
  apt-get update
  apt-get install -y --no-install-recommends $missing
fi

# --- 3. Container engine + compose plugin (official apt repository) ----------
if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  cat > /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi
systemctl enable --now docker
